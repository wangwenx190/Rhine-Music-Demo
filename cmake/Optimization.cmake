include(CheckIPOSupported)
include(CheckLinkerFlag)

option(YALAHOO_RELEASE_IPO "Enable interprocedural optimization in Release" ON)

# Directory options also cover generated QML, test, and asset-tool targets.
if(MSVC)
    add_compile_options("$<$<CONFIG:Release>:/Gy>" "$<$<CONFIG:Release>:/Gw>")
    add_link_options("$<$<CONFIG:Release>:/OPT:REF>" "$<$<CONFIG:Release>:/OPT:ICF>")
elseif(APPLE)
    check_linker_flag(CXX "LINKER:-deduplicate,-dead_strip" YALAHOO_APPLE_CODE_FOLDING)
    if(NOT YALAHOO_APPLE_CODE_FOLDING)
        message(FATAL_ERROR "The Apple linker must support code deduplication and dead stripping")
    endif()
    add_link_options("$<$<CONFIG:Release>:LINKER:-deduplicate,-dead_strip>")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_compile_options("$<$<CONFIG:Release>:-ffunction-sections>"
        "$<$<CONFIG:Release>:-fdata-sections>")
    check_linker_flag(CXX "LINKER:--gc-sections" YALAHOO_LINUX_DEAD_CODE)
    if(NOT YALAHOO_LINUX_DEAD_CODE)
        message(FATAL_ERROR "The Linux linker must support --gc-sections")
    endif()
    add_link_options("$<$<CONFIG:Release>:LINKER:--gc-sections>")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        add_compile_options("$<$<CONFIG:Release>:-fipa-icf>")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        # bfd has no ICF. Use the selected linker when capable, otherwise LLVM lld.
        check_linker_flag(CXX "LINKER:--icf=safe" YALAHOO_LINUX_LINKER_ICF)
        if(NOT YALAHOO_LINUX_LINKER_ICF)
            check_linker_flag(CXX "-fuse-ld=lld;LINKER:--icf=safe" YALAHOO_LINUX_LLD_ICF)
            if(NOT YALAHOO_LINUX_LLD_ICF)
                message(FATAL_ERROR "Clang requires an ICF-capable linker (install LLVM lld)")
            endif()
            set(ipo_linker_option "-fuse-ld=lld")
            add_link_options("$<$<CONFIG:Release>:-fuse-ld=lld>")
        endif()
        add_link_options("$<$<CONFIG:Release>:LINKER:--icf=safe>")
    else()
        message(FATAL_ERROR "Unsupported Linux compiler for identical code folding")
    endif()
endif()

function(yalahoo_check_release_ipo)
    # CheckIPOSupported creates its own project; directory link options are not inherited.
    string(APPEND CMAKE_CXX_FLAGS " ${ipo_linker_option}")
    check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error LANGUAGES CXX)
    if(NOT ipo_supported)
        message(FATAL_ERROR "Release IPO is unavailable: ${ipo_error}")
    endif()
    if(APPLE)
        # CMake's CheckIPOSupported does not accept OBJCXX. Probe its actual LTO flags too.
        include(CheckSourceCompiles)
        if(NOT CMAKE_OBJCXX_COMPILE_OPTIONS_IPO)
            message(FATAL_ERROR "Objective-C++ IPO flags are unavailable")
        endif()
        list(JOIN CMAKE_OBJCXX_COMPILE_OPTIONS_IPO " " CMAKE_REQUIRED_FLAGS)
        set(CMAKE_REQUIRED_LIBRARIES "-framework Foundation")
        check_source_compiles(OBJCXX "int main() { @autoreleasepool { return 0; } }"
            YALAHOO_OBJCXX_IPO)
        if(NOT YALAHOO_OBJCXX_IPO)
            message(FATAL_ERROR "Objective-C++ Release IPO is unavailable")
        endif()
    endif()
endfunction()
if(YALAHOO_RELEASE_IPO)
    yalahoo_check_release_ipo()
    if(APPLE)
        # CMake's target IPO property currently emits flags for CXX, but not OBJCXX.
        foreach(flag IN LISTS CMAKE_OBJCXX_COMPILE_OPTIONS_IPO)
            add_compile_options("$<$<AND:$<CONFIG:Release>,$<COMPILE_LANGUAGE:OBJCXX>>:${flag}>")
            add_link_options("$<$<AND:$<CONFIG:Release>,$<LINK_LANGUAGE:OBJCXX>>:${flag}>")
        endforeach()
    endif()
endif()
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE "${YALAHOO_RELEASE_IPO}")
