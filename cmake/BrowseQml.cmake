function(yalahoo_browse_qml output)
    set(files)
    foreach(name DesignTokens ArchiveText ArchiveButton ThemeSwitch Header BrowseInfo Footer ReadingVeil NavigationFrame Ruler OrdinalReel)
        set(file "${PROJECT_SOURCE_DIR}/qml/Yalahoo/Music/components/${name}.qml")
        set_source_files_properties("${file}" PROPERTIES QT_RESOURCE_ALIAS "components/${name}.qml")
        list(APPEND files "${file}")
    endforeach()
    set(file "${PROJECT_SOURCE_DIR}/qml/Yalahoo/Music/pages/Browse.qml")
    set_source_files_properties("${file}" PROPERTIES QT_RESOURCE_ALIAS "pages/Browse.qml")
    list(APPEND files "${file}")
    set(${output} ${files} PARENT_SCOPE)
endfunction()
